---
import { WA } from '../content/frames';
import { getCollection } from 'astro:content';
import { frentes, type Frente } from '../content/frentes';
const cats = await getCollection('categorias');
const bySlug = Object.fromEntries(cats.map((c) => [c.slug, c.data.nome]));
const nav = [
  ['Produtos', '/produtos'], ['Corte e Dobra', '/corte-e-dobra'], ['Área de Entrega', '/area-de-entrega'],
  ['Empresa', '/empresa'], ['Contato', '/contato'],
];
---
<header class="hdr" id="hdr" data-theme="dark">
  <div class="container hdr__in">
    <a href="/" class="hdr__logo" aria-label="Planeta dos Ferros — início">
      <img src="/logo.svg" alt="Planeta dos Ferros" width="140" height="36" />
    </a>
    <nav class="hdr__nav" aria-label="Principal">
      <div class="mega">
        <a href="/produtos" aria-haspopup="true" aria-expanded="false" class="mega__trigger">Produtos<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m6 9 6 6 6-6"/></svg></a>
        <div class="mega__panel" role="region" aria-label="Categorias de produtos">
          <div class="container mega__grid">
            {(Object.keys(frentes) as Frente[]).map((k) => (
              <div>
                <p class="t-overline">{frentes[k].nome}</p>
                <ul>{frentes[k].ordem.map((slug) => <li><a href={`/produtos/${slug}`}>{bySlug[slug]}</a></li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      {nav.slice(1).map(([l, h]) => <a href={h}>{l}</a>)}
    </nav>
    <div class="hdr__ctas">
      <a href="/corte-e-dobra#projeto" class="btn btn--secondary">Enviar projeto</a>
      <a href={WA('Olá! Vim pelo site e quero um orçamento de aço.')} class="btn btn--whatsapp" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.1.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
        WhatsApp
      </a>
    </div>
    <button class="hdr__menu" aria-label="Abrir menu" aria-expanded="false" aria-controls="mnav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav id="mnav" class="mnav" aria-label="Menu" inert>
    {nav.map(([l, h]) => <a href={h} class="t-h2">{l}</a>)}
    <div class="mnav__ctas">
      <a href="/corte-e-dobra#projeto" class="btn btn--l btn--primary">Enviar projeto</a>
      <a href={WA('Olá! Vim pelo site e quero um orçamento de aço.')} class="btn btn--l btn--whatsapp">WhatsApp</a>
    </div>
  </nav>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--concreto-100);
    background: transparent; transition: background-color var(--motion-base) ease, border-color var(--motion-base) ease;
    border-bottom: 1px solid transparent; }
  .hdr.is-solid { background: var(--grafite-900); border-color: var(--grafite-700); }
  .hdr__in { display: flex; align-items: center; gap: var(--space-32); height: 64px; }
  @media (min-width: 1200px) { .hdr__in { height: 80px; } }
  .hdr__logo img { height: 32px; width: auto; background: #fff; padding: 4px 8px; border-radius: 2px; }
  @media (min-width: 1200px) { .hdr__logo img { height: 40px; } }
  .hdr__nav { display: none; gap: var(--space-32); margin-left: var(--space-16); }
  .hdr__nav a { font-weight: 600; text-decoration: none; opacity: 0.9; white-space: nowrap; }
  .hdr__nav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }
  .mega { position: static; }
  .mega__trigger { display: inline-flex; align-items: center; gap: 4px; }
  .mega__trigger svg { width: 16px; height: 16px; transition: transform var(--motion-base) var(--ease-out); }
  .mega__panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--grafite-900); border-top: 1px solid var(--grafite-700); border-bottom: 1px solid var(--grafite-700);
    opacity: 0; transform: translateY(-6px); visibility: hidden; transition: opacity 150ms ease, transform 150ms var(--ease-out), visibility 0s linear 150ms; }
  .mega:hover .mega__panel, .mega:focus-within .mega__panel { opacity: 1; transform: none; visibility: visible; transition: opacity 200ms ease, transform 200ms var(--ease-out), visibility 0s; }
  .mega:hover .mega__trigger svg, .mega:focus-within .mega__trigger svg { transform: rotate(180deg); }
  .mega__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-32); padding-block: var(--space-32); }
  .mega__grid .t-overline { margin: 0 0 var(--space-12); color: var(--action-primary); }
  .mega__grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .mega__grid li a { display: block; padding: 8px 0; font-weight: 400; opacity: 0.85; }
  .macc summary { list-style: none; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
  .macc summary::-webkit-details-marker { display: none; }
  .macc summary svg { width: 24px; height: 24px; transition: transform var(--motion-base) var(--ease-out); }
  .macc[open] summary svg { transform: rotate(180deg); }
  .macc__g { display: grid; gap: var(--space-8); padding: var(--space-16) 0 var(--space-8) var(--space-16); border-left: 2px solid var(--grafite-700); margin-top: var(--space-12); }
  .macc__g .t-overline { margin: 0; color: var(--action-primary); }
  .hdr__ctas { display: none; gap: var(--space-12); margin-left: auto; }
  @media (min-width: 1200px) { .hdr__nav, .hdr__ctas { display: flex; } }
  .hdr__menu { margin-left: auto; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; color: inherit; cursor: pointer; }
  .hdr__menu svg { width: 24px; height: 24px; }
  .hdr__menu { border-radius: var(--radius-4); transition: transform 160ms var(--ease-out); }
  .hdr__menu:active { transform: scale(0.92); transition-duration: 100ms; }
  .hdr__menu:focus-visible { outline: 2px solid var(--concreto-100); outline-offset: 2px; }
  @media (min-width: 1200px) { .hdr__menu { display: none; } }
  .mnav { position: fixed; inset: 64px 0 0; background: var(--grafite-900); padding: var(--space-32) 16px; display: grid; align-content: start; gap: var(--space-16);
    opacity: 0; transform: translateY(-8px); visibility: hidden;
    transition: opacity 150ms ease, transform 150ms var(--ease-out), visibility 0s linear 150ms; }
  .mnav.is-open { opacity: 1; transform: none; visibility: visible; transition: opacity 200ms ease, transform 200ms var(--ease-out), visibility 0s; }
  .mnav a { text-decoration: none; opacity: 0; transform: translateY(6px); transition: opacity 200ms ease, transform 200ms var(--ease-out); }
  .mnav.is-open a { opacity: 1; transform: none; }
  .mnav.is-open a:nth-child(1) { transition-delay: 30ms } .mnav.is-open a:nth-child(2) { transition-delay: 60ms } .mnav.is-open a:nth-child(3) { transition-delay: 90ms }
  .mnav.is-open a:nth-child(4) { transition-delay: 120ms } .mnav.is-open a:nth-child(5) { transition-delay: 150ms }
  @media (prefers-reduced-motion: reduce) { .mnav, .mnav a { transform: none !important; transition-delay: 0ms !important; } }
  .mnav__ctas { display: grid; gap: var(--space-12); margin-top: auto; padding-top: var(--space-32); }
</style>

<script>
  const hdr = document.getElementById('hdr')!;
  const btn = hdr.querySelector<HTMLButtonElement>('.hdr__menu')!;
  const mnav = document.getElementById('mnav')!;
  const onScroll = () => hdr.classList.toggle('is-solid', window.scrollY > 40);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });
  btn.addEventListener('click', () => {
    const open = !mnav.classList.contains('is-open');
    mnav.classList.toggle('is-open', open); mnav.inert = !open;
    btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    hdr.classList.toggle('is-solid', open || window.scrollY > 40);
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && mnav.classList.contains('is-open')) btn.click(); });
</script>
