---
import { WA } from '../content/frames';
---
<nav class="abar" aria-label="Ações rápidas">
  <a href={WA('Olá! Vim pelo site e quero um orçamento de aço.')} target="_blank" rel="noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.1.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
    <span>WhatsApp</span>
  </a>
  <a href="tel:+559433581449">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    <span>Ligar</span>
  </a>
  <a href="/corte-e-dobra#projeto">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M12 16V4m0 0 4 4m-4-4-4 4M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
    <span>Projeto</span>
  </a>
</nav>
<style>
  .abar { position: fixed; inset: auto 0 0; z-index: 40; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    height: calc(64px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
    background: var(--grafite-900); border-top: 1px solid var(--grafite-700); color: var(--concreto-100); }
  .abar a { display: grid; place-items: center; gap: 4px; text-decoration: none; font-size: 14px; line-height: 20px; font-weight: 600;
    transition: transform 160ms var(--ease-out); }
  .abar a:active { transform: scale(0.95); transition-duration: 100ms; }
  .abar a:focus-visible { outline: 2px solid var(--concreto-100); outline-offset: -4px; border-radius: var(--radius-4); }
  .abar svg { width: 20px; height: 20px; }
  .abar a:first-child { color: var(--whatsapp-500); }
  @media (min-width: 1200px) { .abar { display: none; } }
</style>
