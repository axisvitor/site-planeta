---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ActionBar from '../components/ActionBar.astro';
import Footer from '../components/Footer.astro';
import Steps from '../components/Steps.astro';
import Hero from '../islands/globe/Hero';
import { WA } from '../content/frames';
---
<Base title="Planeta dos Ferros | Ferro e Aço em Parauapebas e Canaã" description="Ferro e aço para construção e serralheria, corte e dobra sob medida e entrega no sul do Pará, de Parauapebas a Xinguara.">
  <Header />
  <main>
    <Hero client:only="react" />

    <section class="how" data-theme="light">
      <div class="container">
        <h2 class="t-h2">Como funciona</h2>
        <Steps items={[
          { title: 'Envie o projeto pelo site ou WhatsApp' },
          { title: 'Nossos técnicos plotam e orçam sem custo' },
          { title: 'Cortamos, dobramos e entregamos na data combinada' },
        ]} />
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <h2 class="t-h2">Tem um projeto na mão?</h2>
        <p class="t-body-lg">Mande agora e receba o orçamento sem custo.</p>
        <div class="cta__row">
          <a href="/corte-e-dobra#projeto" class="btn btn--l btn--primary">Enviar projeto</a>
          <a href={WA('Olá! Vim pelo site e quero um orçamento de aço.')} class="btn btn--l btn--whatsapp" target="_blank" rel="noreferrer">WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ActionBar />
</Base>

<style>
  .how { background: var(--concreto-100); color: var(--grafite-900); padding: var(--space-64) 0; }
  @media (min-width: 1200px) { .how { padding: var(--space-128) 0; } }
  .how h2 { margin: 0 0 var(--space-32); }
  .cta { background: var(--grafite-900); color: var(--concreto-100); padding: var(--space-64) 0; }
  @media (min-width: 1200px) { .cta { padding: var(--space-128) 0; } }
  .cta h2 { margin: 0; }
  .cta p { margin: var(--space-12) 0 0; color: var(--aco-300); }
  .cta__row { display: flex; flex-wrap: wrap; gap: var(--space-12); margin-top: var(--space-32); }
</style>
