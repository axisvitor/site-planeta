---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ActionBar from '../components/ActionBar.astro';
import Footer from '../components/Footer.astro';
import filiais from '../content/filiais.json';
const wa = (n: string, f: string) => `https://wa.me/${n}?text=${encodeURIComponent(`Olá! Vim pelo site e quero falar com a loja de ${f}.`)}`;
const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q + ', PA')}`;
---
<Base title="Lojas e Contato | Planeta dos Ferros" description="Lojas em Parauapebas e Canaã dos Carajás: endereços, telefones, WhatsApp e como chegar." theme="light">
  <Header />
  <main>
    <section class="top" data-theme="dark">
      <div class="container">
        <p class="t-overline">Contato</p>
        <h1 class="t-h1">Fale com a loja mais perto da sua obra.</h1>
      </div>
    </section>
    <section class="sec">
      <div class="container cards">
        {filiais.map((f) => (
          <article class="card">
            <h2 class="t-h3">{f.nome}{f.sede ? ' · sede' : ''}</h2>
            <ul class="info t-body">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>{f.endereco}</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><span>{f.fixoDisplay} · WhatsApp {f.whatsappDisplay}</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>{f.email}</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Horário: [CONFIRMAR]</span></li>
            </ul>
            <div class="actions">
              <a class="btn btn--l btn--whatsapp" href={wa(f.whatsapp, f.nome)} target="_blank" rel="noreferrer">Falar no WhatsApp</a>
              <a class="btn btn--l btn--secondary" href={`tel:+${f.fixo}`}>Ligar</a>
              <a class="btn btn--l btn--ghost" href={maps(f.endereco.split('·')[0] + ', ' + f.nome)} target="_blank" rel="noreferrer">Como chegar</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <ActionBar />
</Base>
<style>
  .top { background: var(--grafite-900); color: var(--concreto-100); padding: calc(64px + var(--space-48)) 0 var(--space-48); }
  @media (min-width: 1200px) { .top { padding: calc(80px + var(--space-64)) 0 var(--space-64); } }
  .top .t-overline { color: var(--action-primary); margin: 0 0 var(--space-12); }
  .top h1 { margin: 0; }
  .sec { padding: var(--space-64) 0; }
  @media (min-width: 1200px) { .sec { padding: var(--space-96) 0; } }
  .cards { display: grid; gap: var(--space-24); }
  @media (min-width: 1200px) { .cards { grid-template-columns: 1fr 1fr; } }
  .card { padding: var(--space-32); border: 1px solid var(--border-subtle); border-radius: var(--radius-2); background: var(--bg-surface); display: grid; gap: var(--space-24); align-content: start; }
  .card h2 { margin: 0; }
  .info { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-12); }
  .info li { display: flex; gap: var(--space-12); align-items: flex-start; }
  .info svg { width: 20px; height: 20px; flex: none; color: var(--brand-blue); margin-top: 2px; }
  .actions { display: grid; gap: var(--space-12); }
  @media (min-width: 768px) { .actions { grid-template-columns: repeat(3, auto); justify-content: start; } }
</style>
